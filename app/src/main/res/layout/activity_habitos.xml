<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <LinearLayout
        android:id="@+id/ll_habitos_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tarjeta_redondeada"
            android:src="@drawable/ic_check"
            android:padding="8dp"
            android:contentDescription="Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RUTINA PASTEL"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progreso &amp; Hábitos"
                android:textColor="@color/neutral"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circulo"
            android:backgroundTint="@color/rose_light"
            android:src="@drawable/ic_perfil"
            app:tint="@color/neutral"
            android:padding="7dp"
            android:contentDescription="Avatar" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="160dp"
        app:layout_constraintTop_toBottomOf="@id/ll_habitos_header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:padding="4dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/filtro_semana"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Semana"
                    android:textColor="@color/neutral"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_selector_activo"
                    android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/filtro_mes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mes"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/filtro_anio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Año"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="horizontal"
                android:padding="20dp"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RENDIMIENTO GENERAL"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tasa de Éxito"
                        android:textColor="@color/neutral"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tv_badge_rendimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈 Datos en tiempo real SQLite ✨"
                        android:textColor="@color/green_soft"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_card_destacada_menta"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="86dp"
                    android:layout_height="86dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/cpi_rendimiento_habitos"
                        android:layout_width="86dp"
                        android:layout_height="86dp"
                        android:progress="0"
                        app:indicatorSize="86dp"
                        app:trackThickness="8dp"
                        app:indicatorColor="#2F4F4F"
                        app:trackColor="@color/gray_input"
                        app:trackCornerRadius="8dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_porcentaje_exito_habitos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/neutral"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Semana"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_destacada_rosa"
                android:orientation="horizontal"
                android:padding="18dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/white"
                    android:src="@drawable/ic_flame"
                    android:padding="10dp"
                    android:contentDescription="Racha" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RACHA DE ORO"
                        android:textColor="@color/secondary_dark"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_racha_dias_habitos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 días consecutivos"
                        android:textColor="@color/neutral"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Imparable!"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_tarjeta_redondeada" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Actividad Semanal"
                            android:textColor="@color/neutral"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lunes 18 - Domingo 24"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Jueves: 96% top"
                        android:textColor="#2D3142"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_chip_normal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:weightSum="7">

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:layout_width="22dp" android:layout_height="85dp" android:background="@drawable/bg_boton_circular" android:backgroundTint="@color/primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:layout_width="22dp" android:layout_height="70dp" android:background="@drawable/bg_boton_circular" android:backgroundTint="@color/primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:layout_width="22dp" android:layout_height="80dp" android:background="@drawable/bg_boton_circular" android:backgroundTint="@color/primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="96%" android:textColor="@color/neutral" android:textSize="10sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                        <View android:layout_width="22dp" android:layout_height="96dp" android:background="@drawable/bg_boton_circular" android:backgroundTint="#3A6351" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J" android:textColor="@color/neutral" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:layout_width="22dp" android:layout_height="78dp" android:background="@drawable/bg_boton_circular" android:backgroundTint="@color/tertiary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="V" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:layout_width="22dp" android:layout_height="65dp" android:background="@drawable/bg_boton_circular" android:backgroundTint="@color/secondary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:layout_width="22dp" android:layout_height="88dp" android:background="@drawable/bg_boton_circular" android:backgroundTint="@color/primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Por Áreas de Vida"
                        android:textColor="@color/neutral"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="METAS ACTIVAS"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circulo" android:backgroundTint="@color/primary" android:layout_marginEnd="8dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Salud &amp; Vitalidad" android:textColor="@color/neutral" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_pct_salud" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="@color/neutral" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_salud" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progress="0" android:progressTint="@color/primary" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circulo" android:backgroundTint="@color/secondary" android:layout_marginEnd="8dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mente &amp; Serenidad" android:textColor="@color/neutral" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_pct_mente" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="@color/neutral" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_mente" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progress="0" android:progressTint="@color/secondary" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circulo" android:backgroundTint="@color/tertiary" android:layout_marginEnd="8dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Productividad Serena" android:textColor="@color/neutral" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_pct_productividad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="@color/neutral" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar android:id="@+id/pb_productividad" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progress="0" android:progressTint="@color/tertiary" android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hábitos Estrella"
                    android:textColor="@color/neutral"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semana en calma"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lista_habitos_estrella"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/ll_estado_vacio_habitos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tarjeta_redondeada"
                    android:backgroundTint="#F8F9FB"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin hábitos registrados"
                        android:textColor="@color/neutral"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tus hábitos de SQLite aparecerán aquí con sus rachas reales 🌱"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_destacada_menta"
                android:orientation="horizontal"
                android:padding="18dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/white"
                    android:src="@drawable/ic_sun"
                    android:padding="8dp"
                    android:contentDescription="Sol" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOMENTO DE MÁXIMO ENFOQUE"
                        android:textColor="@color/green_soft"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu momento del día con mayor enfoque y cumplimiento es la mañana (07:30 - 09:00). ¡Sigue con este ritmo amable y compasivo!"
                        android:textColor="@color/neutral"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_explorar_historico"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔄 Explorar Histórico Completo"
                android:textColor="@color/neutral"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/white"
                app:strokeColor="@color/divider_line"
                app:strokeWidth="1.5dp"
                app:cornerRadius="26dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_exportar_reporte"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📥 Exportar Reporte Mensual (PDF)"
                android:textColor="@color/neutral"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_nuevo_habito_progreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primary"
        android:src="@drawable/ic_add"
        app:tint="@color/neutral"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/barra_inferior"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/barra_inferior"
        style="@style/Widget.MaterialComponents.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_menu_flotante"
        app:itemIconTint="@color/estado_menu"
        app:itemTextColor="@color/estado_menu"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="24dp"
        app:menu="@menu/menu_principal"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
