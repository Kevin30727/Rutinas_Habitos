<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="170dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_saludo_usuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Hola, Sofía! ✨"
                        android:textColor="@color/neutral"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu ritmo de hoy se siente ligero y constante."
                        android:textColor="#8D909F"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_racha_dias_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 14 DÍAS"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_racha_dias" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="horizontal"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOY FLORECE"
                        android:textColor="#4CA977"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tv_habitos_listos_resumen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 hábitos listos"
                        android:textColor="@color/neutral"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tv_descripcion_resumen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tus hábitos diarios avanzan a tu ritmo."
                        android:textColor="#8D909F"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/cpi_hoy_florece"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:progress="0"
                        app:indicatorSize="80dp"
                        app:trackThickness="8dp"
                        app:indicatorColor="@color/primary"
                        app:trackColor="@color/background_app"
                        app:trackCornerRadius="8dp" />

                    <TextView
                        android:id="@+id/tv_porcentaje_hoy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="0%"
                        android:textColor="@color/neutral"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/tv_mes_semana"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mes, Semana"
                        android:textColor="@color/neutral"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_indicador_hoy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOY ES..."
                        android:textColor="#4CA977"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                        <LinearLayout android:id="@+id/bg_dia_1" android:layout_width="44dp" android:layout_height="60dp" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tv_letra_dia_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="#8D909F" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_num_dia_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/neutral" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                        <LinearLayout android:id="@+id/bg_dia_2" android:layout_width="44dp" android:layout_height="60dp" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tv_letra_dia_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" android:textColor="#8D909F" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_num_dia_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/neutral" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                        <LinearLayout android:id="@+id/bg_dia_3" android:layout_width="44dp" android:layout_height="60dp" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tv_letra_dia_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" android:textColor="#8D909F" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_num_dia_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/neutral" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                        <LinearLayout android:id="@+id/bg_dia_4" android:layout_width="44dp" android:layout_height="60dp" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tv_letra_dia_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J" android:textColor="#8D909F" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_num_dia_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/neutral" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                        <LinearLayout android:id="@+id/bg_dia_5" android:layout_width="44dp" android:layout_height="60dp" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tv_letra_dia_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="V" android:textColor="#8D909F" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_num_dia_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/neutral" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                        <LinearLayout android:id="@+id/bg_dia_6" android:layout_width="44dp" android:layout_height="60dp" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tv_letra_dia_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="#8D909F" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_num_dia_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/neutral" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                        <LinearLayout android:id="@+id/bg_dia_7" android:layout_width="44dp" android:layout_height="60dp" android:background="@android:color/transparent" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tv_letra_dia_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D" android:textColor="#8D909F" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_num_dia_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/neutral" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hábitos de hoy"
                    android:textColor="@color/neutral"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_contador_habitos_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 DE 0"
                    android:textColor="#8D909F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_estado_vacio_habitos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/iv_icono_vacio"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_habitos"
                    app:tint="@color/neutral"
                    android:contentDescription="Hábitos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu espacio está en calma 🌱"
                    android:textColor="@color/neutral"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aún no tienes hábitos registrados.\nPresiona '+' para crear tu primer hábito."
                    android:textColor="#8D909F"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_habitos_dinamicos_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_nuevo_habito"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primary"
        android:src="@drawable/ic_add"
        app:tint="@color/neutral"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/barra_inferior"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/barra_inferior"
        style="@style/Widget.MaterialComponents.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_menu_flotante"
        android:elevation="8dp"
        app:itemIconTint="@color/estado_menu"
        app:itemTextColor="@color/estado_menu"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="24dp"
        app:menu="@menu/menu_principal"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
