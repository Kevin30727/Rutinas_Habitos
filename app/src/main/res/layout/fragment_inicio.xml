<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_saludo_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Hola, Sofía! ✨"
                    android:textColor="@color/neutral"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu ritmo de hoy se siente ligero y constante."
                    android:textColor="#8D909F"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_racha_dias_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 0 DÍAS"
                android:textColor="@color/neutral"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:background="@drawable/bg_racha_dias" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_hoy_florece_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_redondeada"
            android:orientation="horizontal"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_hoy_florece_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOY FLORECE"
                    android:textColor="#4CA977"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <TextView
                    android:id="@+id/tv_habitos_listos_resumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 de 0 hábitos listos"
                    android:textColor="@color/neutral"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tv_descripcion_resumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comienza tu día con un paso amable hacia tu bienestar."
                    android:textColor="#8D909F"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/cpi_hoy_florece"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:progress="0"
                    app:indicatorSize="80dp"
                    app:trackThickness="8dp"
                    app:indicatorColor="@color/primary"
                    app:trackColor="@color/mint_light"
                    app:trackCornerRadius="4dp"/>

                <TextView
                    android:id="@+id/tv_porcentaje_hoy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="0%"
                    android:textColor="@color/neutral"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/tv_mes_semana"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Semana"
                    android:textColor="@color/neutral"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_indicador_hoy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOY"
                    android:textColor="#4CA977"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="7">

                <LinearLayout android:id="@+id/bg_dia_1" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_letra_dia_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="#8D909F" android:textSize="12sp"/>
                    <TextView android:id="@+id/tv_num_dia_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/neutral" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/bg_dia_2" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_letra_dia_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" android:textColor="#8D909F" android:textSize="12sp"/>
                    <TextView android:id="@+id/tv_num_dia_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/neutral" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/bg_dia_3" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_letra_dia_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X" android:textColor="#8D909F" android:textSize="12sp"/>
                    <TextView android:id="@+id/tv_num_dia_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/neutral" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/bg_dia_4" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_letra_dia_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J" android:textColor="#8D909F" android:textSize="12sp"/>
                    <TextView android:id="@+id/tv_num_dia_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/neutral" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/bg_dia_5" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_letra_dia_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="V" android:textColor="#8D909F" android:textSize="12sp"/>
                    <TextView android:id="@+id/tv_num_dia_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/neutral" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/bg_dia_6" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_letra_dia_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="#8D909F" android:textSize="12sp"/>
                    <TextView android:id="@+id/tv_num_dia_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/neutral" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/bg_dia_7" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tv_letra_dia_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D" android:textColor="#8D909F" android:textSize="12sp"/>
                    <TextView android:id="@+id/tv_num_dia_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/neutral" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hábitos de hoy"
                android:textColor="@color/neutral"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_contador_habitos_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 DE 0"
                android:textColor="#4CA977"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_card_destacada_menta"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_estado_vacio_habitos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp"
            android:visibility="gone"
            android:background="@drawable/bg_tarjeta_redondeada"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_icono_vacio"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_habitos"
                app:tint="@color/primary"
                android:layout_marginBottom="12dp"
                android:contentDescription="Vacío" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu espacio de hábitos está listo"
                android:textColor="@color/neutral"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pulsa el botón + abajo a la derecha para crear tu primer hábito."
                android:textColor="#8D909F"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_habitos_dinamicos_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
