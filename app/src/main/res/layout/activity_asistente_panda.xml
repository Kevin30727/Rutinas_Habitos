<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- 1. Encabezado de Chat Superior -->
    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/background_app"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_volver_panda"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tarjeta_redondeada"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:contentDescription="Volver" />

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp">

            <View
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/mint_light" />

            <ImageView
                android:id="@+id/iv_avatar_panda_top"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_panda"
                android:contentDescription="Avatar Panda" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panda Asistente 🐼"
                android:textColor="@color/neutral"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En línea • Tu guía compasivo 🟢"
                android:textColor="@color/green_soft"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_saltar_panda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listo"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

    <!-- 2. Área de Conversación / Historial de Mensajes (Scrollable Chat) -->
    <ScrollView
        android:id="@+id/scroll_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar"
        app:layout_constraintBottom_toTopOf="@id/ll_bottom_container">

        <!-- Contenedor dinámico de burbujas de diálogo (Panda a la izquierda, Usuario a la derecha) -->
        <LinearLayout
            android:id="@+id/ll_chat_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 3. Contenedor Inferior: Chips Rápidos + Barra de Entrada -->
    <LinearLayout
        android:id="@+id/ll_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_app"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Sugerencias Rápidas Desplazables Horizontalmente -->
        <HorizontalScrollView
            android:id="@+id/scroll_sugerencias_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_saludo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👋 ¡Hola Panda!"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_como_estas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐼 ¿Cómo estás?"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_estres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌿 Siento estrés o cansancio"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_agua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💧 Beber más agua"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_lectura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 Hábito de lectura"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_ejercicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👟 Caminar y moverme"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_productividad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Mejorar productividad"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_soleado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️ Hoy hace un lindo día soleado"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_consejo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Dame un consejo"
                    android:textColor="@color/neutral"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_normal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Barra de Entrada de Texto Pinned al Fondo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/et_mensaje_usuario"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Escribe un mensaje al Panda..."
                android:textColorHint="@color/text_subtle"
                android:textColor="@color/neutral"
                android:textSize="14.5sp"
                android:paddingHorizontal="16dp"
                android:maxLines="3"
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="actionSend" />

            <ImageButton
                android:id="@+id/btn_enviar_mensaje"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_boton_primario"
                android:src="@drawable/ic_send"
                android:padding="13dp"
                android:contentDescription="Enviar mensaje"
                app:tint="@color/neutral" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
