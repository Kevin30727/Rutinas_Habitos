<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- Encabezado Superior -->
    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_volver_panda"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tarjeta_redondeada"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:contentDescription="Volver" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACOMPAÑANTE DE BIENVENIDA"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panda Asistente 🐼"
                android:textColor="@color/neutral"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_saltar_panda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saltar"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp">

            <!-- Avatar del Panda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp">

                    <View
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/mint_light" />

                    <ImageView
                        android:id="@+id/iv_avatar_panda"
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_panda"
                        android:contentDescription="Avatar Panda" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu guía compasivo"
                    android:textColor="@color/green_soft"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Burbuja de mensaje del Panda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialogo_burbuja"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="2dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tv_mensaje_panda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¡Hola! Soy tu compañero Panda 🐼. Sé que empezar una rutina en blanco puede ser abrumador. Cuéntame, ¿cómo te sientes hoy o qué te gustaría mejorar?"
                    android:textColor="@color/neutral"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <!-- Sugerencias Rápidas / Chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opciones rápidas para orientarte:"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_sugerencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_estres"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌿 Siento estrés o cansancio"
                    android:textColor="@color/neutral"
                    app:chipBackgroundColor="@color/gray_input"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_productividad"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Mejorar productividad"
                    android:textColor="@color/neutral"
                    app:chipBackgroundColor="@color/gray_input"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_agua"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💧 Beber más agua"
                    android:textColor="@color/neutral"
                    app:chipBackgroundColor="@color/gray_input"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lectura"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 Hábito de lectura"
                    android:textColor="@color/neutral"
                    app:chipBackgroundColor="@color/gray_input"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_ejercicio"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👟 Caminar o moverme"
                    android:textColor="@color/neutral"
                    app:chipBackgroundColor="@color/gray_input"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="0dp" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Campo de Entrada Libre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/et_mensaje_usuario"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Escribe cómo te sientes..."
                    android:textColorHint="@color/text_subtle"
                    android:textColor="@color/neutral"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:maxLines="2" />

                <ImageButton
                    android:id="@+id/btn_enviar_mensaje"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_boton_primario"
                    android:src="@drawable/ic_check"
                    android:contentDescription="Enviar"
                    app:tint="@color/neutral" />
            </LinearLayout>

            <!-- Tarjeta de Propuesta del Panda -->
            <LinearLayout
                android:id="@+id/card_propuesta_panda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_destacada_menta"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="3dp"
                android:visibility="gone"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_titulo_propuesta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RUTINAS PROPUESTAS PARA TI"
                    android:textColor="@color/green_soft"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <!-- Banner de Sugerencia Contextual Sinergica -->
                <TextView
                    android:id="@+id/tv_sugerencia_contextual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tarjeta_redondeada"
                    android:padding="12dp"
                    android:textColor="@color/neutral"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:text="💡 Sugerencia contextual"
                    android:visibility="gone" />

                <!-- Contenedor dinámico para múltiples rutinas acumuladas -->
                <LinearLayout
                    android:id="@+id/ll_rutinas_acumuladas_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_aceptar_propuesta"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="✓ Aceptar rutinas y empezar 🌱"
                    android:textColor="@color/neutral"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="24dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
