<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- Barra Superior -->
    <LinearLayout
        android:id="@+id/ll_perfil_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_volver_perfil"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tarjeta_redondeada"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:contentDescription="Volver" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AJUSTES &amp; BIENESTAR"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuración"
                android:textColor="@color/neutral"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tarjeta_redondeada"
            android:src="@drawable/ic_sparkle"
            android:padding="8dp"
            android:contentDescription="Ajustes" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toBottomOf="@id/ll_perfil_header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp">

            <!-- Buscador en ajustes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Buscar" />

                <EditText
                    android:id="@+id/et_buscar_ajustes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Buscar en ajustes..."
                    android:textColorHint="@color/text_subtle"
                    android:textColor="@color/neutral"
                    android:textSize="14sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:inputType="text" />
            </LinearLayout>

            <!-- Banner Espacio Amable -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_destacada_menta"
                android:backgroundTint="@color/lavender_light"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/white"
                    android:src="@drawable/ic_panda"
                    android:padding="8dp"
                    android:contentDescription="Avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌱 ESPACIO AMABLE"
                        android:textColor="@color/green_soft"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu ritmo, tus reglas"
                        android:textColor="@color/neutral"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ajusta cada detalle para que tu rutina sea un abrazo, no una obligación."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECCIÓN 1: Preferencias de Hábitos y Ritmo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preferencias de Hábitos y Ritmo"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <!-- Ítem: Modo Sin Culpa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/mint_light"
                        android:src="@drawable/ic_corazon"
                        android:padding="9dp"
                        app:tint="@color/green_soft"
                        android:contentDescription="Modo sin culpa" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modo Sin Culpa / Pausa..."
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Congela rachas sin penalización..."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_modo_sin_culpa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_line" android:layout_marginBottom="16dp" />

                <!-- Ítem: Horario de Notificaciones -->
                <LinearLayout
                    android:id="@+id/ll_horario_notificaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/blue_light"
                        android:src="@drawable/ic_bell"
                        android:padding="9dp"
                        app:tint="@color/tertiary_dark"
                        android:contentDescription="Notificaciones" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Horario de Notificaciones"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sonido suave de cuencos tibetanos..."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Ir" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_line" android:layout_marginBottom="16dp" />

                <!-- Ítem: Día de inicio de semana -->
                <LinearLayout
                    android:id="@+id/ll_dia_inicio_semana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/lavender_light"
                        android:src="@drawable/ic_calendario"
                        android:padding="9dp"
                        app:tint="@color/neutral"
                        android:contentDescription="Inicio semana" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Día de inicio de semana"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lunes (Predeterminado)"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Ir" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECCIÓN 2: Finanzas y Moneda -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finanzas y Moneda"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <!-- Ítem: Moneda Principal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/rose_light"
                        android:src="@drawable/ic_finanzas"
                        android:padding="9dp"
                        app:tint="@color/secondary_dark"
                        android:contentDescription="Moneda" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Moneda principal"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="USD ($) Dólar estadounidense"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USD"
                        android:textColor="@color/neutral"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_chip_normal" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_line" android:layout_marginBottom="16dp" />

                <!-- Ítem: Presupuesto Mensual Consciente -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/lavender_light"
                        android:src="@drawable/ic_finanzas"
                        android:padding="9dp"
                        app:tint="@color/neutral"
                        android:contentDescription="Presupuesto" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Presupuesto mensual consciente"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$1,200.00 / mes"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Ir" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_line" android:layout_marginBottom="16dp" />

                <!-- Ítem: Ocultar balances en inicio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/blue_light"
                        android:src="@drawable/ic_sparkle"
                        android:padding="9dp"
                        app:tint="@color/neutral"
                        android:contentDescription="Ocultar balances" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ocultar balances en inicio"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Protege tu privacidad con toque..."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_ocultar_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECCIÓN 3: Apariencia y Tema -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apariencia y Tema"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <!-- Tema actual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/mint_light"
                        android:src="@drawable/ic_sparkle"
                        android:padding="9dp"
                        app:tint="@color/green_soft"
                        android:contentDescription="Tema" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tema de la app"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pastel Neo - Calm (Predeterminado)"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <!-- Dots de Paleta Activa -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PALETA ACTIVA"
                                android:textColor="@color/text_muted"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1"
                                android:layout_marginEnd="8dp" />

                            <View android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_circulo" android:backgroundTint="@color/secondary" android:layout_marginEnd="4dp" />
                            <View android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_circulo" android:backgroundTint="@color/tertiary" android:layout_marginEnd="4dp" />
                            <View android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_circulo" android:backgroundTint="@color/primary" android:layout_marginEnd="4dp" />
                            <View android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_circulo" android:backgroundTint="@color/lavender" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/green_soft"
                        android:contentDescription="Seleccionado" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_line" android:layout_marginVertical="16dp" />

                <!-- Modo Oscuro -->
                <LinearLayout
                    android:id="@+id/ll_modo_oscuro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/lavender_light"
                        android:src="@drawable/ic_noche"
                        android:padding="9dp"
                        app:tint="@color/neutral"
                        android:contentDescription="Modo oscuro" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modo oscuro nocturno"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Programado con la puesta de sol"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Ir" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECCIÓN 4: Datos y Seguridad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos y Seguridad"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <!-- Copia de seguridad en la nube -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/mint_light"
                        android:src="@drawable/ic_cloud"
                        android:padding="9dp"
                        app:tint="@color/green_soft"
                        android:contentDescription="Nube" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Copia de seguridad en la nube"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sincronizado hoy en SQLite local"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Al día"
                        android:textColor="@color/green_soft"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_card_destacada_menta" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_line" android:layout_marginBottom="16dp" />

                <!-- Biometría -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/lavender_light"
                        android:src="@drawable/ic_check"
                        android:padding="9dp"
                        app:tint="@color/neutral"
                        android:contentDescription="Biometría" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bloqueo con Biometría / PIN"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mayor protección para tus reflexiones"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_biometria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_line" android:layout_marginBottom="16dp" />

                <!-- Exportar mis datos -->
                <LinearLayout
                    android:id="@+id/ll_exportar_datos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/blue_light"
                        android:src="@drawable/ic_download"
                        android:padding="9dp"
                        app:tint="@color/neutral"
                        android:contentDescription="Exportar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exportar mis datos"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Archivos portables en JSON o CSV"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_download"
                        app:tint="@color/text_muted"
                        android:contentDescription="Descargar" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECCIÓN 5: Cuenta y Soporte -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuenta y Soporte"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_redondeada"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="24dp">

                <!-- Soporte -->
                <LinearLayout
                    android:id="@+id/ll_soporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/rose_light"
                        android:src="@drawable/ic_sparkle"
                        android:padding="9dp"
                        app:tint="@color/secondary_dark"
                        android:contentDescription="Soporte" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Soporte con amor &amp; Preguntas"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estamos aquí para escucharte con calma..."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Ir" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_line" android:layout_marginBottom="16dp" />

                <!-- Términos -->
                <LinearLayout
                    android:id="@+id/ll_terminos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/blue_light"
                        android:src="@drawable/ic_lectura"
                        android:padding="9dp"
                        app:tint="@color/tertiary_dark"
                        android:contentDescription="Términos" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Términos de servicio &amp; Privacidad"
                            android:textColor="@color/neutral"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tus datos nunca son comercializados"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Ir" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botón Cerrar Sesión -->
            <LinearLayout
                android:id="@+id/btn_cerrar_sesion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_boton_peligro_suave"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/secondary_dark"
                    android:contentDescription="Salir" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cerrar sesión"
                    android:textColor="@color/neutral"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <!-- Footer Versión -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="RUTINA PASTEL - V2.4.0 PASTEL"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Hecho con calma y propósito ♡"
                android:textColor="@color/text_subtle"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Botón Flotante e Inferior -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_nuevo_habito_perfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primary"
        android:src="@drawable/ic_add"
        app:tint="@color/neutral"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/barra_inferior"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra Inferior Flotante -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/barra_inferior"
        style="@style/Widget.MaterialComponents.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_menu_flotante"
        app:itemIconTint="@color/estado_menu"
        app:itemTextColor="@color/estado_menu"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="24dp"
        app:menu="@menu/menu_principal"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
